{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorldGen",
  "version": "0.1.0-alpha.1",
  "identifier": "local.worldgen.desktop",
  "build": {
    "beforeDevCommand": "node scripts/build-frontend.mjs",
    "beforeBuildCommand": "node scripts/build-frontend.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "WorldGen — редактор мира",
      "width": 1480,
      "height": 960,
      "minWidth": 960,
      "minHeight": 640,
      "backgroundColor": "#161b20"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Генератор миров и геологический редактор",
    "category": "Education",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "allowDowngrades": true, "nsis": { "languages": ["Russian", "English"], "displayLanguageSelector": true } }
  }
}
